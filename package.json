    "playwright": "^1.63.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.10",
    "husky": "^9.1.7",
    "tsx": "^4.19.3",
    "typescript": "5.9.3"
  }
}
