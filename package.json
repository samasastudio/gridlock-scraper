{
  "name": "gridlock-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts \"tests/**/*.test.ts\"",
